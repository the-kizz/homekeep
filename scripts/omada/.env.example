# omada_status.py configuration — copy to `.env` and fill in.
# `.env` is gitignored. Never commit real credentials.

# --- Controller location -------------------------------------------------
# The OC200's LAN IP. Reachable directly on-site, or over the WireGuard VPN
# once the 192.168.0.0/24 route is up (see docs/omada-remote-access/).
OMADA_HOST=192.168.0.101

# Default Omada controller HTTPS port. OC200 uses 8043; some setups use 443.
OMADA_PORT=8043
OMADA_SCHEME=https

# Optional: set OMADA_BASE_URL to override HOST/PORT/SCHEME entirely,
# e.g. https://omada.example.lan
# OMADA_BASE_URL=

# --- Credentials ---------------------------------------------------------
# Use a dedicated controller account with "Viewer" role if you only need
# read access — don't reuse your cloud/global admin for an automated script.
OMADA_USERNAME=
OMADA_PASSWORD=

# --- Site ----------------------------------------------------------------
# The site name as shown in the controller (top-left site picker).
OMADA_SITE=Default

# --- TLS -----------------------------------------------------------------
# The OC200 ships a self-signed cert, so default is `false` (skip verify).
# For production hardening, export the controller cert and set this to the
# path of a PEM bundle, e.g. OMADA_VERIFY_TLS=/path/to/oc200-ca.pem
OMADA_VERIFY_TLS=false

# Per-request timeout in seconds.
OMADA_TIMEOUT=15
